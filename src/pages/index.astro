---
/**
 * Coming-soon page for the SkyHaven domain. Layout follows the web proposal in "SkyHaven Logo update.pdf" (page 6):
 * white page, full-colour logo, navy headline, input with an amber button. Until launch, the search box is a "Notify me" form.
 * Optional build-time settings (in .env or your host's environment variables):
 *   PUBLIC_WAITLIST_ACTION  URL a form service gives you (e.g. Formspree). When set, the "Notify me" form appears.
 *   PUBLIC_CONTACT_EMAIL    Shown in the footer, and used for the landlord "Get in touch" button, when set.
 * Hero photo: Unsplash (Unsplash License), see skyhaven-photos/CREDITS.csv (apartment-02).
 */
import '../styles/tokens.css';

const waitlistAction = import.meta.env.PUBLIC_WAITLIST_ACTION as string | undefined;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined;
const year = new Date().getFullYear();

const steps = [
	{ title: 'Find a verified home', text: 'Every listing is checked by our team before it goes live.' },
	{ title: 'Pay safely', text: 'Your rent is held by SkyHaven, not sent straight to the landlord.' },
	{ title: 'Move in', text: 'Once you have moved in, the landlord receives their payment.' },
];

const landlordPoints = ['Serious, ready-to-pay tenants', 'Payment secured before move-in', 'A verified badge on your listing'];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>SkyHaven · Find a verified home. Pay safely.</title>
		<meta name="description" content="Every listing is checked by our team, and your rent is held until you move in. SkyHaven is coming soon on web, iPhone and Android." />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#1D5FD6" />
		<meta name="color-scheme" content="light" />
		<meta property="og:title" content="SkyHaven · Coming soon" />
		<meta property="og:description" content="Find a verified home. Pay safely. Every listing checked, rent held until you move in." />
		<meta property="og:image" content="/og-image.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" />
		<link rel="preload" as="image" href="/images/hero-apartment-800.jpg" imagesrcset="/images/hero-apartment-800.jpg 800w, /images/hero-apartment-1600.jpg 1600w" imagesizes="(min-width: 900px) 38vw, 92vw" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<header class="site-header">
			<div class="wrap header-row">
				<a href="/" class="brand"><img src="/skyhaven-logo.svg" alt="SkyHaven" width="172" height="36" /></a>
				<nav aria-label="Main">
					<a href="#how-it-works">How it works</a>
					<a href="#landlords">For landlords</a>
				</nav>
				{waitlistAction ? (
					<a class="btn btn-blue header-cta" href="#notify">Get early access</a>
				) : (
					<span class="soon-pill">Launching soon</span>
				)}
			</div>
		</header>

		<main>
			<section class="hero wrap">
				<div class="copy">
					<p class="eyebrow">Coming soon</p>
					<h1>Find a verified home. Pay safely.</h1>
					<p class="lede">Every listing is checked by our team, and your rent is held until you move in.</p>

					{waitlistAction ? (
						<form id="notify" class="notify" action={waitlistAction} method="POST" data-waitlist>
							<label for="email" class="sr-only">Email address</label>
							<input id="email" name="email" type="email" required autocomplete="email" placeholder="Enter your email" />
							<button type="submit" class="btn btn-amber">Notify me</button>
							<p class="form-note" data-note role="status">Be the first to know when we launch on web, iPhone and Android.</p>
						</form>
					) : (
						<p class="launch-note">Launching soon on web, iPhone and Android.</p>
					)}
				</div>

				<figure class="visual">
					<div class="sun" aria-hidden="true"></div>
					<img
						src="/images/hero-apartment-800.jpg"
						srcset="/images/hero-apartment-800.jpg 800w, /images/hero-apartment-1600.jpg 1600w"
						sizes="(min-width: 900px) 38vw, 92vw"
						width="1600"
						height="1600"
						alt="White apartment building with plants on its balconies under a clear blue sky"
						fetchpriority="high"
					/>
				</figure>
			</section>

			<section id="how-it-works" class="band">
				<div class="wrap">
					<h2>How it works</h2>
					<ol class="steps">
						{steps.map((s, i) => (
							<li>
								<span class="num">{i + 1}</span>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section id="landlords" class="landlords wrap">
				<div>
					<h2>For landlords</h2>
					<p class="section-lede">List your property on SkyHaven when we launch. We check every listing, so tenants trust what they see.</p>
				</div>
				<div class="landlord-side">
					<ul class="ticks">
						{landlordPoints.map((p) => (
							<li>
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
								{p}
							</li>
						))}
					</ul>
					{contactEmail && (
						<a class="btn btn-blue" href={`mailto:${contactEmail}?subject=Listing%20my%20property%20on%20SkyHaven`}>Get in touch</a>
					)}
				</div>
			</section>
		</main>

		<footer>
			<div class="wrap footer-row">
				<span>© {year} SkyHaven</span>
				{contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
			</div>
		</footer>

		<script>
			// Sends the "Notify me" form in the background when the form service accepts JSON (Formspree does).
			// Without JavaScript, or if this fails, the form still posts the normal way.
			const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
			const note = form?.querySelector<HTMLElement>('[data-note]');
			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const button = form.querySelector('button');
				button?.setAttribute('disabled', '');
				try {
					const res = await fetch(form.action, {
						method: 'POST',
						body: new FormData(form),
						headers: { Accept: 'application/json' },
					});
					if (!res.ok) throw new Error(String(res.status));
					form.classList.add('is-done');
					if (note) note.textContent = "You're on the list. We'll email you when SkyHaven launches.";
					form.reset();
				} catch {
					button?.removeAttribute('disabled');
					form.submit();
				}
			});
		</script>
	</body>
</html>

<style>
	:global(html) {
		background: #FFFFFF;
		color-scheme: light;
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html) { scroll-behavior: auto; }
	}
	:global(body) {
		--navy: #0E2A47;
		--blue: #1D5FD6;
		--blue-dark: #174EB3;
		--amber: #E8962B;
		--amber-dark: #D4841C;
		--mist: #F5F8FC;
		--text-2: #55657B;
		--line: #DAE2EE;

		margin: 0;
		overflow-x: clip;
		background: #FFFFFF;
		color: var(--navy);
		font-family: var(--sh-font-body);
		-webkit-font-smoothing: antialiased;
	}
	:global(*, *::before, *::after) {
		box-sizing: border-box;
	}

	.wrap {
		width: 100%;
		max-width: 1160px;
		margin-inline: auto;
		padding-inline: max(20px, env(safe-area-inset-left), 4vw) max(20px, env(safe-area-inset-right), 4vw);
	}

	/* ---------- Buttons ---------- */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font: inherit;
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.2;
		padding: 13px 22px;
		border: 0;
		border-radius: 10px;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 0.15s;
	}
	.btn-blue {
		background: var(--blue);
		color: #FFFFFF;
	}
	.btn-blue:hover {
		background: var(--blue-dark);
	}
	.btn-amber {
		background: var(--amber);
		color: var(--navy);
	}
	.btn-amber:hover {
		background: var(--amber-dark);
	}
	.btn:focus-visible,
	a:focus-visible {
		outline: 3px solid rgba(29, 95, 214, 0.45);
		outline-offset: 2px;
	}

	/* ---------- Header ---------- */
	.site-header {
		border-bottom: 1px solid var(--line);
		background: #FFFFFF;
	}
	.header-row {
		display: flex;
		align-items: center;
		gap: 24px;
		padding-top: max(18px, env(safe-area-inset-top));
		padding-bottom: 18px;
	}
	.brand img {
		display: block;
		width: clamp(136px, 16vw, 172px);
		height: auto;
	}
	nav {
		display: flex;
		gap: 28px;
		margin-left: clamp(24px, 5vw, 72px);
	}
	nav a {
		color: var(--navy);
		text-decoration: none;
		font-size: 0.98rem;
		font-weight: 500;
	}
	nav a:hover {
		color: var(--blue);
	}
	.header-cta,
	.soon-pill {
		margin-left: auto;
	}
	.header-cta {
		padding: 11px 18px;
		font-size: 0.95rem;
	}
	.soon-pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 7px 14px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-2);
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		nav {
			display: none;
		}
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 48px;
		align-items: center;
		padding-top: clamp(48px, 8vw, 96px);
		padding-bottom: clamp(56px, 8vw, 104px);
	}
	@media (min-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
			gap: 6vw;
		}
	}
	.copy {
		max-width: 620px;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 20px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-2);
	}
	h1 {
		margin: 0;
		font-family: var(--sh-font-display);
		font-weight: 800;
		font-size: clamp(2.5rem, 5.6vw, 4rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.lede {
		margin: 20px 0 0;
		max-width: 30em;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: var(--text-2);
	}

	/* Same shape as the proposal's search bar: input + amber button */
	.notify {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		max-width: 560px;
		margin-top: 32px;
		scroll-margin-top: 24px;
	}
	.notify input {
		flex: 1 1 260px;
		min-width: 0;
		font: inherit;
		font-size: 1rem;
		padding: 15px 16px;
		border: 1px solid #CFD9E7;
		border-radius: 10px;
		background: #FFFFFF;
		color: var(--navy);
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.notify input::placeholder {
		color: #7D8A9C;
	}
	.notify input:focus {
		outline: none;
		border-color: var(--blue);
		box-shadow: 0 0 0 4px rgba(29, 95, 214, 0.14);
	}
	.notify .btn {
		padding: 15px 26px;
	}
	.notify .btn[disabled] {
		opacity: 0.7;
		cursor: progress;
	}
	.form-note {
		flex-basis: 100%;
		margin: 2px 0 0;
		font-size: 0.88rem;
		color: #7D8A9C;
	}
	.notify.is-done input,
	.notify.is-done button {
		display: none;
	}
	.notify.is-done .form-note {
		margin: 0;
		padding: 14px 16px;
		border-radius: 10px;
		background: #E6F5F2;
		color: #0B6F61;
		font-size: 0.95rem;
		font-weight: 500;
	}
	.launch-note {
		margin: 28px 0 0;
		font-weight: 500;
		color: var(--navy);
	}
	@media (max-width: 520px) {
		.notify .btn {
			flex-basis: 100%;
		}
	}

	/* Photo in an arched frame (the logo's roof line), with the sun rising behind it */
	.visual {
		position: relative;
		isolation: isolate;
		margin: 0 auto;
		width: min(100%, 400px);
	}
	.visual img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 58% 50%;
		border-radius: 999px 999px 20px 20px;
		box-shadow: 0 24px 48px -16px rgba(14, 42, 71, 0.35);
	}
	.sun {
		position: absolute;
		z-index: -1;
		right: -22%;
		bottom: 6%;
		width: 56%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--amber);
		box-shadow:
			0 0 0 clamp(10px, 1.5vw, 16px) #FFFFFF,
			0 0 0 clamp(12px, 1.8vw, 19px) rgba(232, 150, 43, 0.5),
			0 0 0 clamp(24px, 3.6vw, 40px) #FFFFFF,
			0 0 0 clamp(26px, 3.9vw, 43px) rgba(232, 150, 43, 0.25);
	}
	@media (min-width: 900px) {
		.visual {
			margin: 0 0 0 auto;
		}
		.sun {
			right: -20%;
			bottom: -8%;
			width: 58%;
		}
	}

	/* ---------- Sections ---------- */
	h2 {
		margin: 0;
		font-family: var(--sh-font-display);
		font-weight: 800;
		font-size: clamp(1.75rem, 3.2vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	h3 {
		margin: 0;
		font-family: var(--sh-font-display);
		font-weight: 700;
		font-size: 1.15rem;
	}
	.section-lede {
		margin: 14px 0 0;
		max-width: 30em;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--text-2);
	}

	.band {
		background: var(--mist);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding-block: clamp(56px, 7vw, 88px);
		scroll-margin-top: 0;
	}
	.steps {
		list-style: none;
		margin: 36px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
	}
	.steps li {
		padding: 26px 24px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #FFFFFF;
	}
	.num {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		margin-bottom: 18px;
		border-radius: 50%;
		background: #E7EFFC;
		color: var(--blue);
		font-family: var(--sh-font-display);
		font-weight: 800;
		font-size: 0.95rem;
	}
	.steps p {
		margin: 8px 0 0;
		line-height: 1.6;
		color: var(--text-2);
	}

	.landlords {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 28px 6vw;
		align-items: center;
		padding-top: clamp(56px, 7vw, 88px);
		padding-bottom: clamp(56px, 7vw, 88px);
	}
	@media (min-width: 900px) {
		.landlords {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		}
	}
	.landlord-side {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}
	.ticks {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 14px;
		font-weight: 500;
	}
	.ticks li {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.ticks svg {
		flex: none;
		width: 22px;
		height: 22px;
		padding: 4px;
		border-radius: 50%;
		background: #E7EFFC;
		fill: none;
		stroke: var(--blue);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* ---------- Footer ---------- */
	footer {
		border-top: 1px solid var(--line);
	}
	.footer-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 20px;
		padding-top: 24px;
		padding-bottom: max(24px, env(safe-area-inset-bottom));
		font-size: 0.88rem;
		color: #7D8A9C;
	}
	footer a {
		color: var(--text-2);
		text-decoration: none;
	}
	footer a:hover {
		color: var(--blue);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
